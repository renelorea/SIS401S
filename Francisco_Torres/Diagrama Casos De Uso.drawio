        <mxCell id="JR5CrshqotXAL2Ux5LzV-17" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;➡️PedidoView.java&lt;/div&gt;&lt;div&gt;➡️PedidoMain.java&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="340" x="25" y="670" as="geometry" />
        </mxCell>
        <mxCell id="JR5CrshqotXAL2Ux5LzV-18" parent="JR5CrshqotXAL2Ux5LzV-17" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Estos dos archivos permiten mostrar la vista del programa para el módulo de pedidos, se importan ventanas que incluyen botones de funciones rápidas para que el usuario pueda desarrollar el pedido que se va a hacer, además de que se importa una tabla para realizar pedido de mercancía o de &quot;Stock&quot; para la tienda." vertex="1">
