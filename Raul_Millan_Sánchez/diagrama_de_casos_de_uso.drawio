        <mxCell id="nota0" value="&lt;b&gt;Los roles salen de Usuario.rol: «admin», «empleado» y «cliente». Cada rol hereda los casos de uso de Usuario (flecha de generalización).&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="956" width="1280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="nota1" value="Encuestas: el administrador y el cliente pueden registrar, ver y consultar el promedio; solo el administrador puede eliminar. El empleado no tiene acceso a encuestas." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="982" width="1280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="nota2" value="Abrir módulos del negocio: el menú abre las pantallas de los otros equipos según el rol (inventario, empleados, reportes, clientes, ventas, pedidos y reservas)." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="1008" width="1280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="nota3" value="Cada encuesta se puede responder en el menú de texto (Scanner) o en la ventana (JFrame); los casos de uso son los mismos." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
