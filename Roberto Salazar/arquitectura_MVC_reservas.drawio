<mxfile host="app.diagrams.net">
  <diagram id="mvc2" name="MVC Sistema de Reservas">
    <mxGraphModel dx="2711" dy="1479" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="2300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="view" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacing=10;" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;VIEW&lt;/b&gt;&lt;/font&gt;&lt;br&gt;ReservaView&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Contiene:&lt;/b&gt;&lt;br&gt;• JFrame&lt;br&gt;• JPanel&lt;br&gt;• JTable&lt;br&gt;• JTextField&lt;br&gt;• JTextArea&lt;br&gt;• JComboBox&lt;br&gt;• JButton&lt;br&gt;• JFileChooser&lt;br&gt;&lt;br&gt;&lt;b&gt;Constructor:&lt;/b&gt;&lt;br&gt;• ReservaView(controller, service)&lt;br&gt;&lt;br&gt;&lt;b&gt;Funciones:&lt;/b&gt;&lt;br&gt;• Agregar Reserva&lt;br&gt;• Buscar Reserva&lt;br&gt;• Cambiar Estatus&lt;br&gt;• Editar Comentario&lt;br&gt;• Ver Historial&lt;br&gt;• Exportar Historial&lt;br&gt;• Exportar Reservas&lt;/div&gt;&lt;hr&gt;&lt;i&gt;Recibe la interacción del usuario&lt;/i&gt;" vertex="1">
          <mxGeometry height="410" width="450" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="ctrl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacing=10;" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;CONTROLLER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;ReservaController&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Contiene:&lt;/b&gt;&lt;br&gt;• ReservaService service&lt;br&gt;&lt;br&gt;&lt;b&gt;Constructor:&lt;/b&gt;&lt;br&gt;• ReservaController(service)&lt;br&gt;&lt;br&gt;&lt;b&gt;Funciones:&lt;/b&gt;&lt;br&gt;• agregarReserva()&lt;br&gt;• listarReservas()&lt;br&gt;• cambiarEstatus()&lt;br&gt;• actualizarComentario()&lt;/div&gt;&lt;hr&gt;&lt;i&gt;Comunica Vista y Service&lt;/i&gt;" vertex="1">
          <mxGeometry height="300" width="400" x="620" y="310" as="geometry" />
        </mxCell>
        <mxCell id="serv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacing=10;" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;SERVICE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;ReservaService&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Contiene:&lt;/b&gt;&lt;br&gt;• ReservaRepository repo&lt;br&gt;• List&amp;lt;String&amp;gt; historial&lt;br&gt;&lt;br&gt;&lt;b&gt;Constructor:&lt;/b&gt;&lt;br&gt;• ReservaService(repo)&lt;br&gt;&lt;br&gt;&lt;b&gt;Funciones:&lt;/b&gt;&lt;br&gt;• agregarReserva()&lt;br&gt;• listarReservas()&lt;br&gt;• buscarPorCodigo()&lt;br&gt;• cambiarEstatus()&lt;br&gt;• actualizarComentario()&lt;br&gt;• listarHistorial()&lt;br&gt;• buscarPorNombre()&lt;br&gt;• buscarPorEstatus()&lt;br&gt;• buscarPorPrioridad()&lt;br&gt;• exportarHistorialTxt()&lt;br&gt;• exportarReservasTxt()&lt;/div&gt;&lt;hr&gt;&lt;i&gt;Gestiona la lógica de negocio&lt;/i&gt;" vertex="1">
          <mxGeometry height="400" width="400" x="90" y="620" as="geometry" />
        </mxCell>
        <mxCell id="repo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacing=10;" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;REPOSITORY&lt;/b&gt;&lt;/font&gt;&lt;br&gt;ReservaRepository&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Contiene:&lt;/b&gt;&lt;br&gt;• ArrayList&amp;lt;Reserva&amp;gt; reservas&lt;br&gt;&lt;br&gt;&lt;b&gt;Constructor:&lt;/b&gt;&lt;br&gt;• ReservaRepository()&lt;br&gt;&lt;br&gt;&lt;b&gt;Funciones:&lt;/b&gt;&lt;br&gt;• agregar()&lt;br&gt;• listar()&lt;/div&gt;&lt;hr&gt;&lt;i&gt;Almacena la información en memoria&lt;/i&gt;" vertex="1">
          <mxGeometry height="270" width="400" x="600" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="model" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacing=10;" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;MODELO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Reserva&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Atributos:&lt;/b&gt;&lt;br&gt;• codigo&lt;br&gt;• persona&lt;br&gt;• servicio&lt;br&gt;• cantidad&lt;br&gt;• precio&lt;br&gt;• fecha&lt;br&gt;• prioridad&lt;br&gt;• estatus&lt;br&gt;• comentarios&lt;br&gt;&lt;br&gt;&lt;b&gt;Constructor:&lt;/b&gt;&lt;br&gt;• Reserva(codigo, persona, estatus)&lt;br&gt;&lt;br&gt;&lt;b&gt;Métodos:&lt;/b&gt;&lt;br&gt;• Getters&lt;br&gt;• Setters&lt;/div&gt;&lt;hr&gt;&lt;i&gt;Representa una reserva&lt;/i&gt;" vertex="1">
          <mxGeometry height="370" width="400" x="130" y="1340" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="view" style="endArrow=block;startArrow=block;endFill=1;startFill=1;html=1;strokeWidth=2;" target="ctrl" value="llama métodos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="ctrl" style="endArrow=block;startArrow=block;endFill=1;startFill=1;html=1;strokeWidth=2;" target="serv" value="usa lógica">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="serv" style="endArrow=block;startArrow=block;endFill=1;startFill=1;html=1;strokeWidth=2;" target="repo" value="accede a datos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="repo" style="endArrow=block;startArrow=block;endFill=1;startFill=1;html=1;strokeWidth=2;" target="model" value="guarda / lee objetos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;spacing=10;verticalAlign=top;" value="&lt;b&gt;Flujo al agregar una reserva&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. El usuario llena el formulario&lt;br&gt;2. Presiona «Agregar Reserva»&lt;br&gt;3. ReservaView captura los datos&lt;br&gt;4. ReservaController recibe la acción&lt;br&gt;5. ReservaService valida y procesa&lt;br&gt;6. ReservaRepository la almacena&lt;br&gt;7. Reserva contiene los datos&lt;br&gt;8. La JTable muestra el resultado" vertex="1">
          <mxGeometry height="200" width="300" x="584" y="30" as="geometry" />
        </mxCell>
        <mxCell id="hist" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;spacing=10;verticalAlign=top;" value="&lt;b&gt;Historial de cambios (Service)&lt;/b&gt;&lt;br&gt;&lt;br&gt;cambiarEstatus() y actualizarComentario() registran cada movimiento en la lista historial.&lt;br&gt;&lt;br&gt;• exportarHistorialTxt() → historial_reservas.txt&lt;br&gt;• exportarReservasTxt() → reservas.txt&lt;br&gt;• La ubicación se elige con JFileChooser" vertex="1">
          <mxGeometry height="190" width="300" x="700" y="740" as="geometry" />
        </mxCell>
        <mxCell id="resumen" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;spacing=10;verticalAlign=top;" value="&lt;b&gt;Resumen&lt;/b&gt;&lt;br&gt;&lt;br&gt;• View: muestra la interfaz y recibe acciones&lt;br&gt;• Controller: comunica la Vista con el Service&lt;br&gt;• Service: contiene la lógica de negocio&lt;br&gt;• Repository: almacena los datos&lt;br&gt;• Modelo: representa una reserva" vertex="1">
          <mxGeometry height="170" width="300" x="670" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="l1" edge="1" parent="1" source="flow" style="endArrow=none;dashed=1;html=1;" target="view">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2" edge="1" parent="1" source="hist" style="endArrow=none;dashed=1;html=1;" target="serv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l3" edge="1" parent="1" source="resumen" style="endArrow=none;dashed=1;html=1;" target="repo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
