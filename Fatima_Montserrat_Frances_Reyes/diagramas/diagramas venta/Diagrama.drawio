        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class ReporteFinancieroController {\n        -ReporteFinancieroService service\n        +buscarTodos() ReporteFinanciero\n        +buscarPorProducto(producto: String) int\n        +buscarTotalPorFecha(fecha: String) double\n        +contarVentasPorFecha(fecha: String) int\n        +buscarProductoMasVendido() String\n        +buscarProductoMayorIngreso() String\n        +buscarIngresoPorProducto(producto: String) double\n        +contarVentasSobreProducto(limite: double) int\n        +calcularPromedioVenta() double\n        +contarVentasSobrePromedio() int\n        +contarVentasBajoLimite(limite: double) int\n        +calcularVentasMuyPorEncimaDelPromedio(factor: double) int\n        +calcularDiferenciaIngresos(ingresoActual: double, ingresoAnterior: double) double\n        +calcularVariacionPorcentual(ingresoActual: double, ingresoAnterior: double) double\n        +compararIngresosPorFecha(fechaActual: String, fechaAnterior: String) double\n        +calcularVariacionPorcentualPorFecha(fechaActual: String, fechaAnterior: String) double\n    }\n\n    class SistemaDeInventario {\n        -ArrayList~Venta~ historialVentas\n        -HashMap~String, Producto~ indiceBusqueda\n        -Map~Producto, Integer~ cantidadesStock\n    }\n\n    class Venta {\n        -String idVenta\n        -double total\n        -List~Producto~ articulos\n    }\n\n    class Producto {\n        -String id\n        -String nombre\n        -double precio\n    }\n\n    ReporteFinancieroController ..&gt; SistemaDeInventario : Usa datos\n    SistemaDeInventario \&quot;1\&quot; *-- \&quot;*\&quot; Venta : Guarda ventas (ArrayList)\n    SistemaDeInventario \&quot;1\&quot; *-- \&quot;*\&quot; Producto : Búsqueda rápida (HashMap)\n    SistemaDeInventario \&quot;1\&quot; *-- \&quot;*\&quot; Producto : Calcula cantidad (Map)\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id=